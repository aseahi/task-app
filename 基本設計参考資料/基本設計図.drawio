  <diagram name="システム構成" id="gv3UvGdYw2Mw1r9iNfB6">
    <mxGraphModel dx="568" dy="542" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sxVLPljqJlJ-at6TcWx8-1" parent="1" style="whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;システム構成図&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="160" x="230" y="20" as="geometry" />
        </mxCell>
        <mxCell id="sxVLPljqJlJ-at6TcWx8-2" parent="1" style="whiteSpace=wrap;html=1;align=left;" value="&lt;ul&gt;&lt;li&gt;システム構成はフロントエンド・バックエンド・データベースに分けた構成&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;フロントエンドはReact、バックエンドはJava,Spring Boot、データベースはMySQLを使用する&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;開発環境はローカル環境とし、フロントエンドはReact(&lt;span class=&quot;a_GcMg font-feature-liga-off font-feature-clig-off font-feature-calt-off text-decoration-none text-strikethrough-none&quot; style=&quot;color: rgba(0,0,0,var(--O42jJQ,1)); caret-color: rgb(0, 0, 0); --Ys-XuQ: none; font-kerning: normal;&quot;&gt;Node.js&lt;/span&gt;)、バックエンドはJava (Spring Boot)起動する&lt;/span&gt;&lt;/li&gt;&lt;li&gt;APIテストPostmanを使用。ソースコード管理はGitHubを使用&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="70" width="920" x="390" y="20" as="geometry" />
        </mxCell>
        <mxCell id="sxVLPljqJlJ-at6TcWx8-3" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="利用者" vertex="1">
